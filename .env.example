# ===== 模型接入（二选一）=====

# 方式 A：第三方网关（亚信 erp，OpenAI 兼容，纯文本，推理模型）
DEEPSEEK_API_KEY=uk-xxxxxxxx
DEEPSEEK_BASE_URL=https://tokenerpgw.asiainfo.com/erp/v1
DEEPSEEK_MODEL=AI/deekseek-v4.1-flash
# 推理模型：思考会消耗 token，务必给足，否则 content 会被截断
DEEPSEEK_MAX_TOKENS=8000

# 方式 B：官方 DeepSeek（可选）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# 数据目录（默认 ./data）
# DECISION_DATA_DIR=data
